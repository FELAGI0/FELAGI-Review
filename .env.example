# Application
FELAGI_APP_ENV=development
FELAGI_APP_DEBUG=true
FELAGI_APP_FRONTEND_URL=http://localhost:5174

# JWT
FELAGI_JWT_SECRET=change-me-in-production

# GitHub OAuth App
FELAGI_APP_GITHUB_CLIENT_ID=
FELAGI_APP_GITHUB_CLIENT_SECRET=
FELAGI_APP_GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback

# GitHub App
FELAGI_APP_GITHUB_APP_ID=
FELAGI_APP_GITHUB_APP_PRIVATE_KEY_PATH=/app/secrets/github_app.pem
FELAGI_APP_GITHUB_WEBHOOK_SECRET=
FELAGI_APP_GITHUB_APP_CLIENT_ID=
FELAGI_APP_GITHUB_APP_CLIENT_SECRET=

# AI providers
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security
ENCRYPTION_KEY=
SENTRY_DSN=
