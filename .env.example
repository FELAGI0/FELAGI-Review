# Application
FELAGI_APP_NAME=FELAGI-Review
FELAGI_APP_ENV=development
FELAGI_DEBUG=true
FELAGI_FRONTEND_ORIGIN=http://localhost:5173

# JWT
FELAGI_JWT_SECRET=change-me-in-production
FELAGI_JWT_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql+asyncpg://felagi:felagi@localhost:5432/felagi_review
POSTGRES_USER=felagi
POSTGRES_PASSWORD=felagi
POSTGRES_DB=felagi_review

# Redis
REDIS_URL=redis://localhost:6379/0

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# AI providers
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Security
ENCRYPTION_KEY=
SENTRY_DSN=
